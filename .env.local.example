# Copy to .env.local and fill in.

# Postgres connection string. Local: postgres://user:pass@localhost:5432/secondbrain
# Neon (prod): postgres://...@ep-xxxx.neon.tech/secondbrain?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secondbrain

# --- WorkOS AuthKit ---
# Create an app at https://dashboard.workos.com, then grab these from the dashboard.
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me

# Encrypts the session cookie. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace-me-with-a-long-random-base64-string-of-at-least-32-bytes

# OAuth redirect URI. Must match exactly what's configured in the WorkOS dashboard.
# Local: http://localhost:3000/callback
# Prod:  https://your-domain/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
