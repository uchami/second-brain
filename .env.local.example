# Copy to .env.local and fill in.
# Postgres connection string. Local: postgres://user:pass@localhost:5432/secondbrain
# Neon (prod): postgres://...@ep-xxxx.neon.tech/secondbrain?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secondbrain

# PIN to log in. Any string.
APP_PIN=1234

# Random 32+ char secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-hex-string-of-at-least-32-bytes
